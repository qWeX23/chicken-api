# Copy this file to .env (or pass with --env-file) before `docker compose up`.

# Required: host path to your Google service account JSON credentials.
GOOGLE_APPLICATION_CREDENTIALS_FILE=/absolute/path/to/chicken-api-credentials.json

# Optional: host port mapped to container port 8080.
CHICKEN_API_PORT=8080

# Ollama Cloud runs generation; local Ollama provides embeddings.
KOOG_OLLAMA_BASE_URL=https://ollama.com
KOOG_OLLAMA_EMBEDDING_BASE_URL=http://ollama:11434

# Run scripts/set-ollama-cloud-key.sh to install the dedicated credential securely.
CHICKEN_API_OLLAMA_API_KEY_REQUIRED=true

# Direct Ollama Cloud model name; do not use the local `-cloud` suffix.
KOOG_AGENT_MODEL=gpt-oss:120b

# Keep both jobs disabled until the configured model/provider passes a manual run.
KOOG_AGENT_ENABLED=false
KOOG_AGENT_SCHEDULER_ENABLED=false
KOOG_BREED_RESEARCH_AGENT_ENABLED=false
KOOG_BREED_RESEARCH_AGENT_SCHEDULER_ENABLED=false

# Internal SearXNG search avoids a hosted web-tools credential dependency.
KOOG_OLLAMA_WEB_TOOLS_PROVIDER=searxng
SEARXNG_BASE_URL=http://searxng:8080
# Required when KOOG_OLLAMA_WEB_TOOLS_PROVIDER=ollama.
CHICKEN_API_OLLAMA_WEB_TOOLS_BASE_URL=
# Optional when hosted web tools use a different credential from the model provider.
CHICKEN_API_OLLAMA_WEB_TOOLS_API_KEY=

# Fact diversity controls.
# Fresh web_search calls granted after a duplicate rejection so the agent can find a different topic.
KOOG_AGENT_RETRY_SEARCH_BUDGET_PER_DUPLICATE=3
# Comma-separated domains never used as sources (default wikipedia.org).
KOOG_AGENT_EXCLUDED_SEARCH_DOMAINS=wikipedia.org
# Optional comma-separated domains to rank first in search results.
KOOG_AGENT_PREFERRED_SEARCH_DOMAINS=
# Whole-fact similarity threshold for duplicate rejection.
KOOG_AGENT_FACT_DEDUP_THRESHOLD=0.88
# Similarity threshold used to cluster existing facts into covered topics.
KOOG_AGENT_TOPIC_CLUSTER_THRESHOLD=0.78
# Maximum number of covered topics reported to the agent after a duplicate.
KOOG_AGENT_MAX_COVERED_TOPICS=15
# Reject facts from a source domain once this many existing facts use it.
KOOG_AGENT_SOURCE_DOMAIN_MAX_REPEATS=3

# Staggered daily schedules in local time.
KOOG_AGENT_SCHEDULER_CRON="0 15 4 * * *"
KOOG_BREED_RESEARCH_AGENT_SCHEDULER_CRON="0 15 5 * * *"
KOOG_AGENT_SCHEDULER_ZONE=America/Chicago
KOOG_BREED_RESEARCH_AGENT_SCHEDULER_ZONE=America/Chicago
